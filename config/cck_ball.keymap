#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <2>;
};

&soft_off { hold-time-ms = <2000>; };

&mt {
	tapping-term-ms = <150>;
    flavor = "balanced";
};
&lt {
    flavor = "balanced";
};

#define LEFT_HAND_KEYS   0  1  2  3  4  5  \
                         12 13 14 15 16 17 \
                         24 25 26 27 28 29 \
                         36 37 38
#define LEFT_THUMB_KEYS           39 40 41

#define RIGHT_HAND_KEYS  6  7  8  9  10 11 \
                         18 19 20 21 22 23 \
                         30 31 32 33 34 35 \
                                  45 46 47
#define RIGHT_THUMB_KEYS 42 43 44

#define BASE 0
#define SYM  1
#define NUM  2
#define FUN  3
#define SYS  4
#define NAV  5
#define MED  6
#define GAME 7
#define PTR  8

/ {
    zoom_encoder: zoom_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp LC(KP_PLUS)>, <&kp LC(KP_MINUS)>;

            tap-ms = <30>;
    };

    macros {
        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LMETA &kp LSHFT>
                , <&macro_tap &kp N4>
                , <&macro_release &kp LMETA &kp LSHFT>
                ;
        };

		window_next: window_next {
			compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LMETA>
                , <&macro_tap &kp GRAVE>
                , <&macro_release &kp LMETA>
                ;
		};

		window_prev: window_prev {
			compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LMETA &kp LSHFT>
                , <&macro_tap &kp GRAVE>
                , <&macro_release &kp LMETA &kp LSHFT>
                ;
		};
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS RIGHT_THUMB_KEYS>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <LEFT_HAND_KEYS LEFT_THUMB_KEYS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&window_next &kp Q        &kp W       &kp F        &kp P         &kp B         &kp J       &kp L        &kp U        &kp Y       &kp SQT      &kp BSPC
&window_prev &hml LMETA A &hml LALT R &hml LCTRL S &hml LSHFT T  &kp G         &kp M       &hmr RSHFT N &hmr RCTRL E &hmr RALT I &hmr RMETA O &kp SQT
&screenshot  &kp Z        &kp X       &kp C        &kp D         &kp V         &kp K       &kp H        &kp COMMA    &kp DOT     &kp SLASH    &kp RSHFT
&caps_word   &kp LALT     &kp LMETA   &lt SYS ESC  &lt NAV SPACE &lt MED TAB   &lt SYM RET &lt NUM BSPC &lt FUN DEL  &kp RMETA   &kp RALT     &tog GAME
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>, <&zoom_encoder>;
        };

        symbol {
            bindings = <
&none      &kp LBRC    &kp AMPS   &kp ASTRK   &kp LPAR      &kp RBRC      &none       &none        &none       &none      &none       &none
&none      &kp COLON   &kp DLLR   &kp PRCNT   &kp CARET     &kp PLUS      &none       &kp RSHFT    &kp RCTRL   &kp RALT   &kp RMETA   &none
&none      &kp TILDE   &kp EXCL   &kp AT      &kp POUND     &kp PIPE      &none       &none        &none       &none      &none       &none
&none      &none       &none      &kp LPAR    &kp RPAR      &kp UNDER     &none       &none        &none       &none      &none       &none
            >;
        };

        number {
            bindings = <
&none      &kp LBKT    &kp N7     &kp N8      &kp N9        &kp RBKT      &none       &none        &none       &none      &none       &none
&none      &kp SEMI    &kp N4     &kp N5      &kp N6        &kp EQUAL     &none       &kp RSHFT    &kp RCTRL   &kp RALT   &kp RMETA   &none
&none      &kp GRAVE   &kp N1     &kp N2      &kp N3        &kp BSLH      &none       &none        &none       &none      &none       &none
&none      &none       &none      &kp DOT     &kp N0        &kp MINUS     &none       &none        &none       &none      &none       &none
            >;
        };

        function {
            bindings = <
&none      &none       &kp F7     &kp F8      &kp F9        &kp F12       &none       &none        &none       &none      &none       &none
&none      &none       &kp F4     &kp F5      &kp F6        &kp F11       &none       &kp RSHFT    &kp RCTRL   &kp RALT   &kp RMETA   &none
&none      &none       &kp F1     &kp F2      &kp F3        &kp F10       &none       &none        &none       &none      &none       &none
&none      &none       &none      &none       &none         &none         &none       &none        &none       &none      &none       &none
            >;
        };

        system {
            bindings = <
&none       &none       &none      &none       &none         &none         &none       &none        &none        &none        &none        &none
&none       &kp LMETA   &kp LALT   &kp LCTRL   &kp LSHFT     &none         &none       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
&none       &none       &none      &none       &none         &none         &none       &bt BT_CLR   &none        &none        &none        &none
&bootloader &none       &none      &none       &none         &none         &none       &none        &none        &none        &none        &bootloader
            >;
        };

        navigation {
            bindings = <
&none      &none       &none      &none       &none         &none         &none        &none        &none      &none      &none       &none
&none      &kp LMETA   &kp LALT   &kp LCTRL   &kp LSHFT     &none         &none        &kp LEFT     &kp DOWN   &kp UP     &kp RIGHT   &none
&none      &none       &none      &none       &none         &none         &none        &kp HOME     &kp PG_DN  &kp PG_UP  &kp END     &none
&none      &none       &none      &none       &none         &none         &none        &none        &none      &none      &none       &none
            >;
        };

        media {
            bindings = <
&none      &none       &none      &none       &none         &none         &none        &none        &none      &none      &none       &none
&none      &kp LMETA   &kp LALT   &kp LCTRL   &kp LSHFT     &none         &none        &none        &none      &none      &none       &none
&none      &none       &none      &none       &none         &none         &none        &none        &none      &none      &none       &none
&none      &none       &none      &none       &none         &none         &kp C_PREV   &kp C_PLAY   &kp C_NEXT &none      &none       &none
            >;
        };

        gaming {
            bindings = <
&kp TAB    &kp Q     &kp W      &kp E        &kp R          &kp T         &kp Y        &kp U        &kp I         &kp O        &kp P        &kp BSPC
&kp CAPS   &kp A     &kp S      &kp D        &kp F          &kp G         &kp H        &kp J        &kp K         &kp L        &kp SEMI     &kp SQT
&kp LSHFT  &kp Z     &kp X      &kp C        &kp V          &kp B         &kp N        &kp M        &kp COMMA     &kp DOT      &kp SLASH    &kp RSHFT
&kp LCTRL  &kp LALT  &kp LMETA  &kp ESC      &kp SPC        &kp TAB       &kp RET      &kp BSPC     &kp DEL       &kp RMETA    &kp RALT     &tog GAME
            >;
        };

        pointer {
            bindings = <
&none      &none       &none      &none        &none        &none         &none        &none        &none      &none      &none       &none
&none      &kp LMETA   &kp LALT   &kp LCTRL    &kp LSHFT    &none         &none        &none        &none      &none      &none       &none
&none      &none       &none      &none        &none        &none         &none        &none        &none      &none      &none       &none
&none      &none       &none      &mo SYS      &mkp LCLK    &mkp RCLK     &none        &none        &none      &none      &none       &none
            >;
        };
    };
};
