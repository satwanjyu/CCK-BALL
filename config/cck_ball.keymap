#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&lt {
    flavor = "balanced";
};

#define BASE 0
#define SYM  1
#define NUM  2
#define FUN  3  
#define SYS  4
#define MED  5
#define NAV  6
#define PTR  7
#define GAME 8

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp TAB    &kp Q     &kp W      &kp F        &kp P          &kp B         &kp J        &kp L         &kp U       &kp Y     &kp SEMI   &kp BSPC
&kp LCTRL  &kp A     &kp R      &kp S        &kp T          &kp G         &kp M        &kp N         &kp E       &kp I     &kp O      &kp SQT
&kp LSHFT  &kp Z     &kp X      &kp C        &kp D          &kp V         &kp K        &kp H         &kp COMMA   &kp DOT   &kp SLASH  &kp RSHFT
&caps_word &kp LALT  &kp LMETA  &lt SYS ESC  &lt MED SPACE  &lt NAV TAB   &lt SYM RET  &lt NUM BSPC  &lt FUN DEL &kp RMETA &kp RALT   &tog GAME
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        symbol {
            bindings = <
&none      &kp LBRC  &kp AMPS   &kp ASTRK    &kp LPAR       &kp RBRC      &none        &none         &none       &none     &none      &none
&none      &kp COLON &kp DLLR   &kp PRCNT    &kp CARET      &kp PLUS      &none        &none         &none       &none     &none      &none
&none      &kp TILDE &kp EXCL   &kp AT       &kp POUND      &kp PIPE      &none        &none         &none       &none     &none      &none
&none      &none     &none      &kp LPAR     &kp RPAR       &kp UNDER     &none        &none         &none       &none     &none      &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        number {
            bindings = <
&none      &kp LBKT  &kp N7     &kp N8       &kp N9         &kp RBKT      &none        &none         &none       &none     &none      &none
&none      &kp SEMI  &kp N4     &kp N5       &kp N6         &kp EQUAL     &none        &none         &none       &none     &none      &none
&none      &kp GRAVE &kp N1     &kp N2       &kp N3         &kp BSLH      &none        &none         &none       &none     &none      &none
&none      &none     &none      &kp DOT      &kp N0         &kp MINUS     &none        &none         &none       &none     &none      &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        function {
            bindings = <
&none      &none     &kp F7     &kp F8       &kp F9         &kp F12       &none        &none         &none       &none     &none      &none
&none      &none     &kp F4     &kp F5       &kp F6         &kp F11       &none        &none         &none       &none     &none      &none
&none      &none     &kp F1     &kp F2       &kp F3         &kp F10       &none        &none         &none       &none     &none      &none
&none      &none     &none      &none        &none          &none         &none        &none         &none       &none     &none      &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        system {
            bindings = <
&none      &none     &none      &none        &none          &none         &none        &none        &none         &none        &none        &kp C_PWR
&none      &none     &none      &none        &none          &none         &none        &bt BT_SEL 0 &bt BT_SEL 1  &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
&none      &none     &none      &none        &none          &none         &none        &bt BT_CLR   &none         &none        &none        &none
&none      &none     &none      &none        &none          &none         &none        &none        &none         &none        &none        &bootloader
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        media {
            bindings = <
&none      &none     &none      &none        &none          &none         &none        &none        &none         &none        &none        &none
&none      &none     &none      &none        &none          &none         &none        &none        &none         &none        &none        &none       
&none      &none     &none      &none        &none          &none         &none        &none        &none         &none        &none        &none
&none      &none     &none      &none        &none          &none         &kp C_PREV   &kp C_PLAY   &kp C_NEXT    &none        &none        &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        navigation {
            bindings = <
&none      &none     &none      &none        &none          &none         &none        &none        &none         &none        &none        &none
&none      &none     &none      &none        &none          &none         &none        &kp LEFT     &kp DOWN      &kp UP       &kp RIGHT    &none       
&none      &none     &none      &none        &none          &none         &none        &kp HOME     &kp PG_DN     &kp PG_UP    &kp END      &none
&none      &none     &none      &none        &none          &none         &none        &none        &none         &none        &none        &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        pointer {
            bindings = <
&none      &none     &none      &none        &none          &none         &none        &none        &none         &none        &none        &none
&none      &none     &none      &none        &none          &none         &none        &none        &none         &none        &none        &none       
&none      &none     &none      &none        &none          &none         &none        &none        &none         &none        &none        &none
&none      &none     &none      &none        &none          &mkp LCLK     &mkp RCLK    &none        &none         &none        &none        &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        gaming {
            bindings = <
&kp TAB    &kp Q     &kp W      &kp E        &kp R          &kp T         &kp Y        &kp U        &kp I         &kp O        &kp P        &none
&kp CAPS   &kp A     &kp S      &kp D        &kp F          &kp G         &kp H        &kp J        &kp K         &kp L        &kp SEMI     &kp SQT       
&kp LSHFT  &kp Z     &kp X      &kp C        &kp V          &kp B         &kp N        &kp M        &kp COMMA     &kp DOT      &kp SLASH    &kp RSHFT
&kp LCTRL  &none     &none      &kp ESC      &kp SPC        &kp TAB       &none        &none        &none         &none        &none        &tog GAME
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
